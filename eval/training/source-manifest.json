  "datasetLicenseRule": "Datasets retain their upstream licenses and are never relicensed as MIT by inclusion in this manifest.",
  "policy": {
    "defaultDisposition": "excluded",
    "allowedDispositions": [
      "primary",
      "optional-fetch-only",
      "excluded"
    ],
    "repositoryDistribution": "manifest-only",
    "commitRawData": false,
    "commitTransformedShards": false,
    "inferLicenseFromProvenance": false,
    "acceptMirrorLicenseMetadataAsAuthoritative": false,
    "privacyMinimizationRequired": true,
    "immutableSnapshotRequired": true,
    "downloadSha256Required": true,
    "incidentFamilyDenylistRequired": true,
    "groupSplitBySourceLineageRequired": true,
    "sourceLineageGate": {
      "requiredForReleasedFitCorpus": true,
      "staticFenSourceWithoutLineage": "policy-ineligible-for-public-release",
      "mayClaimEnforcedWithoutLineage": false,
      "enforcement": "policy-only",
      "executableReleaseGateImplemented": false
    },
    "finalFitLabels": {
      "requiredProducer": "pinned-external-stockfish",
      "allowUpstreamLabelsAsFinalFitLabels": false,
      "teacherBundledInMitRepository": false,
      "requiredProvenance": [
        "stockfishReleaseOrCommit",
        "executableSha256",
        "nnueFilename",
        "nnueSha256",
        "uciOptions",
        "threads",
        "hashSize",
        "tablebaseConfiguration",
        "deterministicNodeOrDepthBudget",
        "labelPerspective",
        "scoreConversion",
        "inputSnapshot",
        "filters",
        "randomSeed",
        "splitAndGroupingRules",
        "outputSha256"
      ]
    },
    "generatedArtifactLicenseReview": {
      "status": "working-release-position-not-legal-advice",
      "gnuFaqReferences": [
        "https://www.gnu.org/licenses/gpl-faq.en.html#WhatCaseIsOutputGPL",
        "https://www.gnu.org/licenses/gpl-faq.en.html#GPLOutput"
      ],
      "stockfishOutputPosition": "Numeric labels are not presumed GPL-covered merely because a GPL program produced them; copied protectable program material would require a separate analysis.",
      "stockfishBinaryObligationsAreSeparate": true,
      "inputDatasetRightsRemainApplicable": true,
      "teacherProvenanceRequired": true,
      "mitLicenseIsNotAutomatic": true,
      "artifactLicenseDecisionRequired": true,
      "legalReviewBeforePublicRelease": true,
      "coveredArtifacts": [
        "generated-label-corpora",
        "hce-parameter-sets",
        "nnue-checkpoints"
      ]
    },
    "optionalSourceGate": {
      "enabledByDefault": false,
      "explicitSourceIdOptInRequired": true,
      "preserveUpstreamLicense": true,
      "preserveRequiredNotices": true,
      "relabelingDoesNotClearUpstreamObligations": true
    },
    "releaseGate": [
      "source-disposition-allowed",
      "immutable-download-resolved",
      "download-sha256-verified",
      "upstream-license-recorded",
      "required-attribution-recorded",
      "raw-and-derived-data-outside-git",
      "privacy-minimized",
      "positions-legality-validated",
      "incident-family-denylist-applied",
      "source-lineage-group-split-applied",
      "pinned-stockfish-labels-generated",
      "run-manifest-and-output-checksums-recorded",
      "generated-artifact-license-and-legal-review-recorded"
    ]
  },
