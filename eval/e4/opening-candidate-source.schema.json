{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chessy.invalid/schema/e4/opening-candidate-source.schema.json",
  "title": "Chessy E4 opening-candidate source policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source",
    "filters",
    "identity",
    "extraction",
    "output"
  ],
  "properties": {
    "schema": {
      "const": "chessy.e4.opening-candidate-source-policy.v1"
    },
    "status": {
      "const": "preregistered"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dataset",
        "release",
        "archive",
        "forbiddenSources"
      ],
      "properties": {
        "id": {
          "const": "lichess-standard-rated-pgn"
        },
        "dataset": {
          "const": "Lichess standard rated games"
        },
        "release": {
          "const": "2026-06"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "bytes",
            "sha256",
            "compression",
            "license"
          ],
          "properties": {
            "url": {
              "const": "https://database.lichess.org/standard/lichess_db_standard_rated_2026-06.pgn.zst"
            },
            "bytes": {
              "const": 28241946492
            },
            "sha256": {
              "const": "8fd81071f56511e7546cb77e38db5cf32f7e8a437fb906e26959cc064d8b1f79"
            },
            "compression": {
              "const": "zstd"
            },
            "license": {
              "const": "CC0-1.0"
            }
          }
        },
        "forbiddenSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "accepted",
                "reason"
              ],
              "properties": {
                "url": {
                  "const": "https://database.lichess.org/standard/lichess_db_standard_rated_2026-06.pgn.zst.torrent"
                },
                "accepted": {
                  "const": false
                },
                "reason": {
                  "const": "stale-torrent-metadata-is-not-source-evidence"
                }
              }
            }
          ],
          "items": false
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialPosition",
        "variantTags",
        "ratedSpeeds",
        "ratedEventKinds",
        "minimumElo",
        "botTitle",
        "botsAllowed",
        "selfPlayAllowed"
      ],
      "properties": {
        "initialPosition": {
          "const": "standard-only-no-SetUp-or-FEN"
        },
        "variantTags": {
          "const": [
            "absent",
            "Standard"
          ]
        },
        "ratedSpeeds": {
          "const": [
            "Blitz",
            "Rapid",
            "Classical"
          ]
        },
        "ratedEventKinds": {
          "const": [
            "game",
            "tournament",
            "swiss"
          ]
        },
        "minimumElo": {
          "const": 1800
        },
        "botTitle": {
          "const": "BOT"
        },
        "botsAllowed": {
          "const": false
        },
        "selfPlayAllowed": {
          "const": false
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sitePrefix",
        "gameIdRegex",
        "caseSensitive",
        "outputIdNamespace",
        "rawIdRetention"
      ],
      "properties": {
        "sitePrefix": {
          "const": "https://lichess.org/"
        },
        "gameIdRegex": {
          "const": "^[A-Za-z0-9]{8}$"
        },
        "caseSensitive": {
          "const": true
        },
        "outputIdNamespace": {
          "const": "chessy.e4.lichess-standard-rated.2026-06"
        },
        "rawIdRetention": {
          "const": "forbidden-in-candidate-output"
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "candidatePly",
        "sampling",
        "teacher",
        "balance",
        "incidentDenial"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eco",
            "openingFamily",
            "maximumOpeningCharacters"
          ],
          "properties": {
            "eco": {
              "const": "trimmed-[A-E][0-9]{2}"
            },
            "openingFamily": {
              "const": "NFC-trimmed-prefix-before-first-colon"
            },
            "maximumOpeningCharacters": {
              "const": 256
            }
          }
        },
        "candidatePly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum",
            "algorithm",
            "domain"
          ],
          "properties": {
            "minimum": {
              "const": 12
            },
            "maximum": {
              "const": 20
            },
            "algorithm": {
              "const": "sha256-modulo-inclusive-window"
            },
            "domain": {
              "const": "chessy.e4.opening-candidate-ply.v1"
            }
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "domain",
            "modulus",
            "numerator",
            "maximumCandidates",
            "overflow"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256-threshold-then-lowest-digest"
            },
            "domain": {
              "const": "chessy.e4.opening-candidate-sample.v1"
            },
            "modulus": {
              "const": 4096
            },
            "numerator": {
              "const": 64
            },
            "maximumCandidates": {
              "const": 25000
            },
            "overflow": {
              "const": "retain-lowest-full-digests"
            }
          }
        },
        "teacher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest",
            "id",
            "engine",
            "nodeLimit",
            "scorePov"
          ],
          "properties": {
            "manifest": {
              "const": "eval/training/teacher-sf18-100kn-v1.json"
            },
            "id": {
              "const": "sf18-100kn-v1"
            },
            "engine": {
              "const": "Stockfish 18"
            },
            "nodeLimit": {
              "const": 100000
            },
            "scorePov": {
              "const": "white"
            }
          }
        },
        "balance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scoreKind",
            "maximumAbsoluteCp",
            "mateAllowed",
            "boundAllowed"
          ],
          "properties": {
            "scoreKind": {
              "const": "exact-cp"
            },
            "maximumAbsoluteCp": {
              "const": 200
            },
            "mateAllowed": {
              "const": false
            },
            "boundAllowed": {
              "const": false
            }
          }
        },
        "incidentDenial": {
          "const": "cluster-and-position-family-before-scoring"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "order",
        "overwrite",
        "sidecarSchema"
      ],
      "properties": {
        "schema": {
          "const": "chessy.e4.opening-candidate.v1"
        },
        "format": {
          "const": "canonical-ndjson"
        },
        "order": {
          "const": "recordId-unicode-code-point"
        },
        "overwrite": {
          "const": false
        },
        "sidecarSchema": {
          "const": "chessy.e4.opening-candidate-sidecar.v1"
        }
      }
    }
  }
}
