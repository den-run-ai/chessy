{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chessy.invalid/schema/e4/opening-candidate.schema.json",
  "title": "Chessy E4 opening candidate v1",
  "description": "Schema for each canonical NDJSON row produced by the pinned E4 opening-candidate compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recordId",
    "sourceGameId",
    "fen",
    "eco",
    "openingFamily",
    "initialBalanceCp"
  ],
  "properties": {
    "schema": {
      "const": "chessy.e4.opening-candidate.v1"
    },
    "recordId": {
      "type": "string",
      "pattern": "^chessy\\.e4\\.lichess-standard-rated\\.2026-06:candidate:[0-9a-f]{64}$"
    },
    "sourceGameId": {
      "type": "string",
      "pattern": "^chessy\\.e4\\.lichess-standard-rated\\.2026-06:game:[0-9a-f]{64}$"
    },
    "fen": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:[prnbqkPRNBQK1-8]+/){7}[prnbqkPRNBQK1-8]+ [wb] (?:-|[KQkq]+) (?:-|[a-h][36]) (?:0|[1-9][0-9]*) [1-9][0-9]*$"
    },
    "eco": {
      "type": "string",
      "pattern": "^[A-E][0-9]{2}$"
    },
    "openingFamily": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ll][Ii][Cc][Hh][Ee][Ss][Ss]\\.org/))[^\\u0000-\\u001f\\u007f]+$"
    },
    "initialBalanceCp": {
      "type": "integer",
      "minimum": -200,
      "maximum": 200
    }
  }
}
