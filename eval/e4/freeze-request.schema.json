  "properties": {
    "schema": {
      "const": "chessy.e4.freeze-request.v1"
    },
    "freezeBaseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "release",
        "url",
        "license"
      ],
      "properties": {
        "id": {
          "const": "lichess-standard-rated-pgn"
        },
        "name": {
          "const": "Lichess database"
        },
        "release": {
          "const": "2026-06"
        },
        "url": {
          "const": "https://database.lichess.org/standard/lichess_db_standard_rated_2026-06.pgn.zst"
        },
        "license": {
          "const": "CC0-1.0"
        }
      }
    },
    "rawArchiveSha256": {
      "const": "8fd81071f56511e7546cb77e38db5cf32f7e8a437fb906e26959cc064d8b1f79"
    },
    "candidateNdjsonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidateManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "stockfish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executableSha256",
        "networkSha256s"
      ],
      "properties": {
        "executableSha256": {
          "const": "6b087694916228c905a5e14db74cca8c7e5643602226af1fa5d42353c455b9f9"
        },
        "networkSha256s": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "const": "c288c895ea924429ea9092e3f36b2b3c1f00f2a3a4c759ff7e57e79e3b43e4a7"
            },
            {
              "const": "37f18f62d772f3107e1d6aaca3898c130c3c86f2ab63e6555fbbca20635a899d"
            }
          ],
          "items": false
        }
      }
    },
    "exploration": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/easySchedule"
        },
        {
          "$ref": "#/$defs/mediumSchedule"
