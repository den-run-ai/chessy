{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chessy.invalid/schema/e4/freeze-request.schema.json",
  "title": "Chessy E4 opening-manifest freeze request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "freezeBaseCommit",
    "source",
    "rawArchiveSha256",
    "candidateNdjsonSha256",
    "candidateManifestSha256",
    "stockfish",
    "exploration"
