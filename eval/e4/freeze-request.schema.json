      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "easySchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "anchorAllocation"
      ],
      "properties": {
        "level": {
          "const": "easy"
        },
        "anchorAllocation": {
          "$ref": "#/$defs/easyAllocations"
        }
      }
    },
    "mediumSchedule": {
